#%RAML 1.0
title: Flights Process API
version: v1

types:
  Flight: !include datatypes/Flight.raml

/flights:
  get:
    queryParameters:
      destination?:
        type: string
        enum: ["SFO", "LAX", "CLE"]
        displayName: Flight Destination
        description: IATA code of the airport where the flight is scheduled to arrive.
        example: "LAX"

    responses:
      200:
        body:
          application/json:
            type: Flight[]
            example: !include examples/flights-example.json

  /{flightId}:
    get:
      responses:
        200:
          body:
            application/json:
              type: Flight
              example: !include examples/flight-example.json

/weather:
  /publish:
    post:
      description: Publish provided weather data to the message queue.
      body:
        application/json:
          type: object
          properties:
            city:
              type: string
              description: Name of the city
              example: "Kyiv"
            temperature:
              type: number
              description: Temperature in Celsius
              example: 5.4
            condition:
              type: string
              description: Weather condition description
              example: "Cloudy"
      responses:
        200:
          description: Weather data published successfully
          body:
            application/json:
              type: object
              properties:
                status:
                  type: string
                  example: "success"
                message:
                  type: string
                  example: "Weather data for Kyiv published"

