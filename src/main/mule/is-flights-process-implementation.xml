<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:file="http://www.mulesoft.org/schema/mule/file" xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:mongo="http://www.mulesoft.org/schema/mule/mongo"
	xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/amqp http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd
http://www.mulesoft.org/schema/mule/mongo http://www.mulesoft.org/schema/mule/mongo/current/mule-mongo.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
http://www.mulesoft.org/schema/mule/file http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd">
	<amqp:config name="AMQP_Config" doc:name="AMQP Config" doc:id="92f1255f-8e10-4e6e-9117-09d472ddb628" >
		<amqp:connection host="${mq.host}" port="${mq.port}" username="${mq.username}" password="${mq.password}" />
	</amqp:config>
	<sub-flow name="getFlights" doc:id="cac18073-697e-4ddd-8693-21b49ba8d8c5" >
		<set-variable value="#[message.attributes.queryParams.destination]" doc:name="destination" doc:id="465179e4-4d8b-49d7-9928-8ef6ed47720b" variableName="destination" />
		<set-variable value='#[{ "status": "Get American Flights request"}]' doc:name="logMessage" doc:id="abd8ec34-626c-407f-9252-1fee3a8f85b2" variableName="logMessage" />
		<flow-ref doc:name="logAudit" doc:id="fd56df2e-cb94-4b79-b6e2-ea4e40aa6300" name="logAudit" />
		<http:request method="GET" doc:name="GET sa /flights" doc:id="c9caf679-5141-45fc-820f-8ccefada0228" config-ref="HTTP_System_Api_config" path="/flights">
			<http:query-params ><![CDATA[#[output application/java
---
{
	("destination": vars.destination) if (!isEmpty(vars.destination))
}]]]></http:query-params>
			<http:response-validator >
				<http:success-status-code-validator values="200..599" />
			</http:response-validator>
		</http:request>
		<flow-ref doc:name="responseProcesingSubFlow" doc:id="33532c7f-c9b6-4914-887f-486c97a683e1" name="responseProcessingSubFlow" />
	</sub-flow>
	<sub-flow name="getFlightById" doc:id="ba912eb7-751b-4eed-8bdf-7c5bd03fbcca" >
		<set-variable value="#[attributes.uriParams.flightId]" doc:name="flightId" doc:id="266c126b-c5a7-4c48-9d8b-3373d1cfae8b" variableName="flightId" />
		<set-variable value='#[{ "status": "Get American Flights request"}]' doc:name="logMessage" doc:id="3047b57f-1785-4f84-8bfc-a0c3770a6c16" variableName="logMessage" />
		<flow-ref doc:name="logAudit" doc:id="86f88c73-54f0-44c8-9db7-3f8a5aca4bb7" name="logAudit" />
		<http:request doc:name="GET sa /flights/{ID}" doc:id="f556a45b-fcfa-4333-a6e6-fd86697cf10f" config-ref="HTTP_System_Api_config" path="/flights/{Id}" >
			<http:uri-params ><![CDATA[#[output application/java
---
{
	Id : vars.flightId
}]]]></http:uri-params>
			<http:response-validator >
				<http:success-status-code-validator values="0..599" />
			</http:response-validator>
		</http:request>
		<flow-ref doc:name="responseProcesingSubFlow" doc:id="1e9ce55f-30f3-415f-83fe-18222e9223a0" name="responseProcessingSubFlow"/>
	</sub-flow>
	<!-- [STUDIO:"Scheduler"]<flow name="Scheduler" doc:id="eb1d1d4d-72e7-4892-8cb3-2be531f73b5c" initialState="stopped">
		<scheduler doc:name="Scheduler" doc:id="66f26e0b-03df-43d3-acfd-094b81a6c4ec" >
			<scheduling-strategy >
				<fixed-frequency frequency="2" timeUnit="MINUTES"/>
			</scheduling-strategy>
		</scheduler>
		<flow-ref doc:name="publishCountries" doc:id="6061a44f-b118-4ade-b69a-6ca8bf9ce9e8" name="publishCountries"/>
	</flow> [STUDIO] -->
	<sub-flow name="publishCountries" doc:id="54f817c8-a5c2-4c29-9d16-92e74655595f" >
		<http:request doc:name="GET /countries" doc:id="09067d66-5085-4f75-88a9-d77e4f25ae6a" config-ref="HTTP_System_Api_config" path="/countries">
			<http:query-params><![CDATA[#[output application/java
---
{
	"subregion" : "Eastern Europe"
}]]]></http:query-params>
		</http:request>
		<parallel-foreach doc:name="Parallel For Each" doc:id="3feb2588-6758-494b-ac18-dc9f1ab6041e" >
			<set-variable value="#[payload.name]" doc:name="country" doc:id="6374107f-3cc9-4343-a31b-a58384509251" variableName="country" />
			<set-variable value="#[payload.capital.name]" doc:name="city" doc:id="93d6fbbb-0ca3-44b7-9c5e-eb63ac463baf" variableName="city"/>
			<amqp:publish doc:name="Publish" doc:id="371916a9-f7a2-4470-957a-1917829f6ed5" config-ref="AMQP_Config" exchangeName="country.city.topic" deliveryMode="PERSISTENT" routingKeys='#[[ (lower(vars.country default "") replace /[ .]+/ with "-") ++ "." ++ (lower(vars.city default "") replace /[ .]+/ with "-") ++ ".updated" ]]'>
		</amqp:publish>
		</parallel-foreach>
		<set-payload value="Countries published." doc:name="Countries published" doc:id="babc7607-35c6-4645-9e76-34a5fc1f8c76" />
	</sub-flow>
	<flow name="Weather_Snapshots_Consumer" doc:id="64bdf0b8-367a-4783-93ab-9386452fa455" >
		<amqp:listener doc:name="Listener" doc:id="132ddb35-0079-4cd0-aa47-5d3a3856f195" config-ref="AMQP_Config" queueName="country.city.queue" ackMode="MANUAL">
			<redelivery-policy maxRedeliveryCount="2"/>
		</amqp:listener>
		<set-variable value="#[attributes.ackId]" doc:name="ackId" doc:id="987e0c45-d3f0-47ba-bc41-a5e33db98322" variableName="ackId"/>
		<http:request doc:name="GET /weather" doc:id="19aed6c2-a497-423f-a15d-4dfc3f7b3735" config-ref="HTTP_System_Api_config" path="/weather123" target="weatherData">
			<http:query-params><![CDATA[#[output application/java
---
{
	"city" : payload.capital.name
}]]]></http:query-params>
		</http:request>
		<ee:transform doc:name="Create weather snapshot" doc:id="df86bc66-417f-472a-9727-f11ef094bbdd" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  country: payload.name,
  countryCode: upper(payload.code default ""),
  capital: {
    city: payload.capital.name,
    longitude: vars.weatherData.location.lon default payload.capital.lng,
    latitude: vars.weatherData.location.lat default payload.capital.lat,
    weatherConditions: {
      visibility: vars.weatherData.weather.visibility default 0,
      temperature: { 
        degrees: "Celsius", 
        current: vars.weatherData.weather.temperature default 0 

      },
      pressure: vars.weatherData.weather.pressure default 0,
      humidity: vars.weatherData.weather.humidity default 0,
      wind: vars.weatherData.weather.wind
    }
  },
  lastUpdated: (now() >> "UTC") as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<http:request doc:name="POST /weatherSnaphsot" doc:id="a7f95f2d-06f3-45b6-a96b-a133e987fe58" config-ref="HTTP_System_Api_config" method="POST" path="/weatherSnapshot" target="weatherSnapshotResult" />
		<amqp:publish doc:name="Publish" doc:id="14748407-0762-4709-b7b5-4f25f724ddeb" config-ref="AMQP_Config" exchangeName="country.city.topic" deliveryMode="PERSISTENT">
			<amqp:routing-keys >
				<amqp:routing-key value="weather.snapshot.fetched" />
			</amqp:routing-keys>
		</amqp:publish>
		<amqp:ack doc:name="Ack" doc:id="68d1b793-fa60-47fe-945c-9306244c96a3" ackId="#[vars.ackId]"/>
	</flow>
	<flow name="Alert_Consumer" doc:id="bedff6f1-93be-4578-b4ca-b69e740ce912" >
		<amqp:listener doc:name="Listener" doc:id="c1fd1be8-17fe-44c0-b118-533271d2649f" config-ref="AMQP_Config" queueName="alert.evaluate" ackMode="MANUAL">
			<redelivery-policy maxRedeliveryCount="2" />
		</amqp:listener>
		<logger level="INFO" doc:name="Logger" doc:id="086392d7-4011-427d-b839-7487e5490b41" message='#["Processing city: " ++ payload.capital.city]' />
		<set-variable value="#[attributes.ackId]" doc:name="ackId" doc:id="2ea82eb9-eaa2-4b61-b550-67088790d952" variableName="ackId" />
		<set-variable value="#[payload.capital.weatherConditions.visibility]" doc:name="visibility" doc:id="3e5f645e-b003-413a-9041-f68c8f061ed4" variableName="visibility" />
		<choice doc:name="Visibility tier" doc:id="ae135edf-c12b-4299-8f16-576f2fba5187" >
			<when expression="#[vars.visibility &lt; 5000]">
				<logger level="INFO" doc:name="Logger" doc:id="f75c5ca2-011a-4d93-b7ea-871b99961cfc" message="WARN: Reduced visibility. Pay increased attention during flight"/>
			</when>
			<when expression="#[vars.visibility &lt; 3000]">
				<logger level="INFO" doc:name="Logger" doc:id="b00c0f84-c7d2-43e1-a9d2-62961f048648" message="CRITICAL: Low visibility Pay increased attention during flight. Delays possible"/>
			</when>
			<otherwise>
				<logger level="INFO" doc:name="Logger" doc:id="bf4ab1af-9194-43c9-a1ee-1f36c3367047" message="Clear weather. Happy flight!"/>
			</otherwise>
		</choice>
		<amqp:ack doc:name="Ack" doc:id="f4b1ca69-43b9-43ee-acb0-10ffeea84270" ackId="#[vars.ackId]" />
	</flow>
	<flow name="countryDLQ_Listener" doc:id="3cb648d3-75c6-4c38-aa1d-f02a8e3bbfda">
		<amqp:listener doc:name="country.city.queue.dlq" doc:id="e31419f9-1741-4245-8236-4294aafe586b" config-ref="AMQP_Config" queueName="country.city.queue.dlq" ackMode="MANUAL"/>
		<ee:transform doc:name="Transform Message" doc:id="733efc40-967b-4c26-b331-2c7a32d1a266" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	messageId: attributes.properties.messageId default correlationId,
    processedAt: now(),
    "x-death": attributes.headers.'x-death' default [],
    "payload": payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="saveDeadLetter" doc:id="8c5a1212-0b68-4f00-a79d-db0241c9be73" name="saveDeadLetter"/>
	</flow>
	<flow name="alertDLQ_Listener" doc:id="bad66bea-03d2-41c0-a5ee-dec1e1128a33">
		<amqp:listener doc:name="alert.evaluate.dlq" doc:id="3f7d726e-a640-4871-b38b-1a3ecb3d5eb3" config-ref="AMQP_Config" queueName="alert.evaluate.dlq" ackMode="MANUAL" />
		<ee:transform doc:name="Transform Message" doc:id="ec5b492c-a6dc-4b51-b2b6-20ed4e66c920">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	messageId: attributes.properties.messageId default correlationId,
    processedAt: now(),
    "x-death": attributes.headers.'x-death' default [],
    "payload": payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="saveDeadLetter" doc:id="4b9a9869-bc7f-4179-8bbb-cf2e772a5137" name="saveDeadLetter" />
	</flow>
	<flow name="saveDeadLetter" doc:id="22143fa3-e09d-41ad-a5a5-b0e665a71e4a" >
		<set-variable value="#[attributes.ackId]" doc:name="ackId" doc:id="d56d8038-d34b-4641-af12-8cf6821fa9cd" variableName="ackId"/>
		<try doc:name="Try" doc:id="3a377d03-49a0-4211-9ea8-e6e772a98c06" >
			<http:request doc:name="POST /deadLettersOffice" doc:id="30a15288-ecb4-402d-807d-a89d5fd984b0" method="POST" config-ref="HTTP_System_Api_config" path="/deadLettersOffice" />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="6c43edfd-4e06-4595-aae5-013d86be2858">
				<flow-ref doc:name="parkingLotWrite" doc:id="ca0490ac-bfbf-47bd-9a79-ac1abac1e01d" name="parkingLotWrite" />
			</on-error-continue>
			</error-handler>
		</try>
		<amqp:ack doc:name="" doc:id="d0edea1f-43a1-441c-a7ea-c57b41d4032c" ackId="#[vars.ackId]"/>
	</flow>
	<sub-flow name="getWeatherSnapshot" doc:id="ae6fd0c0-8ecb-4c30-9eb3-9062ac5ff3ef" >
		<set-variable value="#[attributes.queryParams.countryCode]" doc:name="countryCode" doc:id="726c6aa6-a34a-42ce-ae9c-7ac35618a4d2" variableName="countryCode"/>
		<http:request doc:name="GET /weatherSnapshot" doc:id="8ec9b0c5-c44d-4bf2-8e1b-b50b05057fe5" config-ref="HTTP_System_Api_config" path="/weatherSnapshot">
			<http:query-params ><![CDATA[#[output application/java
---
{
	"countryCode" : vars.countryCode
}]]]></http:query-params>
		</http:request>
	</sub-flow>
	<sub-flow name="parkingLotWrite" doc:id="3ec8935c-4df9-4d61-a14c-8b639ad30cbd" >
		<file:write doc:name="Write" doc:id="e6bf227d-2f45-4ea2-b76f-650648c17512" config-ref="parkingLotConfig" path="deadLetters_parkingLot.log" mode="APPEND">
			<file:content ><![CDATA[#[%dw 2.0
output text/plain
---
write(payload, "application/json", {indent: false}) ++ "\n"]]]></file:content>
		</file:write>
	</sub-flow>
</mule>
